# Base de datos
POSTGRES_DB=mediateca
POSTGRES_USER=mediateca
POSTGRES_PASSWORD=mediateca
POSTGRES_PORT=5432

# Meilisearch
MEILI_ENV=development
MEILI_MASTER_KEY=dev_master_key_change_me_123456
MEILI_PORT=7700
MEDIATECA_MEILISEARCH_INDEX=ediciones

# Puertos publicos
API_PORT=8000
WEB_PORT=3000
MEDIATECA_DASHBOARD_PORT=8080

# Entorno
MEDIATECA_ENVIRONMENT=development
MEDIATECA_API_CORS_ORIGINS=http://localhost:3000
MEDIATECA_OPAC_BASE_URL=https://gestiona.comunidad.madrid
MEDIATECA_LOG_LEVEL=INFO

# Ingesta
MEDIATECA_CRAWL_DELAY=1.0
MEDIATECA_WORKER_CONCURRENCY=1
MEDIATECA_WORKER_POLL_SECONDS=5.0
MEDIATECA_WORKER_HEARTBEAT_SECONDS=30.0
MEDIATECA_WORKER_STALE_SECONDS=120

# Scheduler
MEDIATECA_SCHEDULER_ENABLED=true
MEDIATECA_SCHEDULER_POLL_SECONDS=60

# Dashboard
MEDIATECA_DASHBOARD_HOST=127.0.0.1
MEDIATECA_DASHBOARD_REFRESH_SECONDS=15
MEDIATECA_DASHBOARD_RECENT_LIMIT=20
MEDIATECA_DASHBOARD_WORKER_STALE_SECONDS=120
MEDIATECA_DASHBOARD_ADMIN_TOKEN=

# FlareSolverr
MEDIATECA_FLARESOLVERR_URL=
MEDIATECA_FLARESOLVERR_MAX_TIMEOUT_MS=60000

# TMDB
MEDIATECA_TMDB_API_TOKEN=
MEDIATECA_TMDB_LANGUAGE=es-ES
MEDIATECA_TMDB_DELAY=0.25
MEDIATECA_TMDB_TIMEOUT=10
MEDIATECA_TMDB_MAX_RETRIES=3

# Registry de imagenes (deploy/portainer-stack.yml)
MEDIATECA_REGISTRY=192.168.1.169:5000
MEDIATECA_IMAGE_TAG=latest
