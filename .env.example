# PostgreSQL
POSTGRES_DB=mediateca
POSTGRES_USER=mediateca
POSTGRES_PASSWORD=mediateca
POSTGRES_PORT=5432

# Meilisearch
MEILI_ENV=development
MEILI_MASTER_KEY=dev_master_key_change_me_123456
MEILI_PORT=7700

# Puertos publicos
API_PORT=8000
WEB_PORT=3000

# Backend
MEDIATECA_ENVIRONMENT=development
MEDIATECA_MEILISEARCH_INDEX=ediciones
MEDIATECA_API_CORS_ORIGINS=http://localhost:3000
MEDIATECA_CRAWL_DELAY=1.0
MEDIATECA_OPAC_BASE_URL=https://gestiona.comunidad.madrid
MEDIATECA_HARVEST_QUERIES=cine,documental,animacion,musica
MEDIATECA_SCHEDULER_HARVEST_HOURS=24
MEDIATECA_SCHEDULER_AVAILABILITY_HOURS=6
MEDIATECA_LOG_LEVEL=INFO

# Para ejecutar el backend fuera de Docker:
# MEDIATECA_DATABASE_URL=postgresql+psycopg://mediateca:mediateca@localhost:5432/mediateca
# MEDIATECA_MEILISEARCH_URL=http://localhost:7700
# MEDIATECA_MEILISEARCH_KEY=dev_master_key_change_me_123456
# MEDIATECA_RAW_DIR=./data/raw

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
